# Backend environment — copy to flask-server/.env and fill in.
# (.env is gitignored; never commit real values.)

# --- Web app ---
BASE_PATH=/
USE_SSL=false

# --- PanTS dataset (primary) ---
# Folder that contains metadata.xlsx + image_only/ + mask_only/.
PANTS_PATH=/mnt/bodymaps/zzhou82/data/PanTS
# Writable dir for precomputed PanTS low-res volumes (make_lowres.py output).
PANTS_LOWRES_PATH=/home/visitor/pants_lowres

# --- CancerVerse dataset (second, CT-only for now) ---
# Folder that contains the CV_########/ct.nii.gz cases. The metadata CSV lives
# NEXT TO this folder: <parent>/CancerVerse_dataset_metadata.csv.
# Leave unset to disable CancerVerse (search/endpoints stay PanTS-only).
CANCERVERSE_PATH=/mnt/bodymaps/zzhou82/data/CancerVerse
# Writable dir for CancerVerse low-res volumes:
#   <CANCERVERSE_LOWRES_PATH>/image_only/CV_########/ct_lowres.nii.gz
CANCERVERSE_LOWRES_PATH=/home/visitor/cancerverse_lowres

# --- Database ---
# Full SQLAlchemy URL for the app database (inference job state; accounts later).
# Unset -> a local SQLite file at flask-server/pants-dev.db (fine for dev).
#
# PRODUCTION: point at an absolute path OUTSIDE the git working tree, on LOCAL
# disk (SQLite's file locking is unreliable over NFS). Create the dir once:
#   mkdir -p /home/visitor/pants-app-data
# then set:
#   DATABASE_URL=sqlite:////home/visitor/pants-app-data/pants.db
# (note the four slashes: sqlite:/// + an absolute /home/... path)
#
# Run `alembic upgrade head` (from flask-server/) after setting this, and on
# every deploy that adds a migration.
# DATABASE_URL=sqlite:////home/visitor/pants-app-data/pants.db

# --- Sessions ---
# SESSIONS_DIR_PATH=sessions
# PERMISSIONS_DIR=/home/visitor/data

# --- Accounts / auth ---
# Signs the Flask session cookie (Authlib stores the OAuth CSRF `state` there).
# REQUIRED in production and must be stable across restarts — if unset, the app
# generates a random key at boot and any in-flight OAuth login breaks on reload.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Browsers that may call the API with credentials (comma-separated). Must be
# exact origins — no wildcard, since auth rides in a cookie.
# ALLOWED_ORIGINS=https://bdmap1.wse.jhu.edu

# Send the session cookie only over HTTPS. Set true in production.
# SESSION_COOKIE_SECURE=true

# Where OAuth sends the browser back after sign-in (your frontend origin).
# Defaults to http://localhost:5173 for dev.
# FRONTEND_URL=https://bdmap1.wse.jhu.edu

# --- OAuth providers (optional) ---
# Leave unset to disable a provider; its button stays disabled in the UI and
# /api/auth/oauth/providers reports it as unavailable.
#
# Google: console.cloud.google.com > APIs & Services > Credentials >
#   Create OAuth client ID > Web application. Authorized redirect URI:
#   https://<your-domain>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# GitHub: github.com/settings/developers > New OAuth App.
#   Authorization callback URL:
#   https://<your-domain>/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Legacy Postgres vars (unused) ---
# Nothing reads these anymore; superseded by DATABASE_URL. Kept commented so an
# old .env doesn't look wrong. Delete once no server .env references them.
# DB_USER=
# DB_PASS=
# DB_HOST=
# DB_NAME=
